{
  "name": "parqet-beer",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "pnpm check",
    "test": "svelte-kit sync && vitest run",
    "test:watch": "svelte-kit sync && vitest",
    "test:coverage": "svelte-kit sync && vitest run --coverage",
    "test:data": "svelte-kit sync && vitest run tests/data-validation.test.ts",
    "pretest:e2e": "./scripts/e2e-certs.sh",
    "test:e2e": "svelte-kit sync && playwright test",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:assets": "node scripts/generate-assets.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "jose": "^6.2.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261107.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@resvg/resvg-js": "2.6.2",
    "@sveltejs/adapter-cloudflare": "8.0.2",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.158.0"
  }
}
